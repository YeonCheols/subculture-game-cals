{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "headers": [
    {
      "source": "/remote-api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" },
        { "key": "CDN-Cache-Control", "value": "max-age=300, stale-while-revalidate=3600" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/remote-api/events",
      "destination": "https://subculture-schdule-api.vercel.app/api/v2/events"
    },
    {
      "source": "/remote-api/:path*",
      "destination": "https://subculture-schdule-api.vercel.app/api/v1/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
